---
import type { Post } from '@/payload/payload-types'

import CollectionArchive from './CollectionArchive.astro'
import Layout from './Layout.astro'

const { docs = [] } = Astro.props as { docs?: Post[] }
---

{docs.length > 0 && (
  <Layout sideColumn bottom>
    <h3 slot="side" class="text-2xl flex-none w-full text-center item lg:text-left lg:w-80 overflow-hidden">More</h3>
    <CollectionArchive slot="main" class="w-full" docs={docs} />
  </Layout>
)}
