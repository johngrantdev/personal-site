---
interface Props {
  top?: boolean
  bottom?: boolean
  fullHeight?: boolean | null
  class?: string
}

const { top = false, bottom = false, fullHeight = false, class: className = '' } = Astro.props
---

<div class:list={[
  className,
  'w-full gap-x-10 gap-y-8 lg:gap-x-24',
  top ? 'pt-24' : 'pt-0',
  bottom ? 'pb-12' : 'pb-0',
  fullHeight && 'min-h-screen overflow-hidden',
]}>
  <slot />
</div>
