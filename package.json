{
  "name": "johngrant-dev",
  "description": "Website template for Payload",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint --fix --ext .ts,.tsx src",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-nested-docs": "3.88.0",
    "@payloadcms/plugin-redirects": "3.88.0",
    "@payloadcms/plugin-seo": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@react-spring/web": "^10.1.2",
    "cross-env": "^7.0.3",
    "escape-html": "^1.0.3",
    "graphql": "^16.11.0",
    "next": "16.3.1",
    "next-plausible": "4.0.0",
    "next-themes": "^0.2.1",
    "payload": "3.88.0",
    "payload-blurhash-plugin": "3.1.0",
    "prism-react-renderer": "^2.3.1",
    "qs": "6.12.0",
    "react": "19.2.8",
    "react-code-blocks": "^0.1.5",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.51.0",
    "react-player": "^2.15.1",
    "sharp": "0.34.2",
    "type-fest": "^4.12.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.1",
    "@swc/core": "^1.4.6",
    "@types/escape-html": "^1.0.2",
    "@types/node": "22.19.9",
    "@types/qs": "^6.9.12",
    "@types/react": "19.2.18",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "autoprefixer": "^10.4.18",
    "css-loader": "^6.8.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-filenames": "^1.3.2",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "postcss": "^8.4.31",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.3.5",
    "tailwindcss-3d": "^1.0.5",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^20.9.0 || >=22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
