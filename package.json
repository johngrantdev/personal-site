{
  "name": "personal-site",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "pnpm --filter @personal-site/cms dev",
    "build": "pnpm --filter @personal-site/cms build",
    "start": "pnpm --filter @personal-site/cms start",
    "typecheck": "pnpm -r typecheck",
    "seed": "pnpm --filter @personal-site/cms-config seed",
    "lint": "pnpm -r lint",
    "generate:types": "pnpm --filter @personal-site/cms-config generate:types",
    "generate:importmap": "pnpm --filter @personal-site/cms generate:importmap"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.18",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-filenames": "^1.3.2",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "prettier": "^3.2.5",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^20.9.0 || >=22.0.0"
  }
}
